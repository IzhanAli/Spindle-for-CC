#!/usr/bin/env python3
"""Thin launcher so `spindle` runs from a checkout with no install step.

Resolves symlinks (so it works when symlinked onto $PATH), puts the package
source on sys.path, and dispatches to the CLI.
"""
import os
import sys

_here = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
_src = os.path.join(os.path.dirname(_here), "src")
if os.path.isdir(_src) and _src not in sys.path:
    sys.path.insert(0, _src)

from spindle.__main__ import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
