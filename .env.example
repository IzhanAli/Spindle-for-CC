# spindle secrets — copy to `.env` and fill in. `.env` is gitignored.
#
# Loaded automatically (stdlib, no dependency) from the first of:
#   $SPINDLE_ENV · $SPINDLE_HOME/.env · ~/.config/spindle/.env · ./.env
# Anything already exported in your shell takes precedence over this file.

# Cheap GPT model that compresses spinner headlines (see [ai] in config.toml).
OPENAI_API_KEY=

# Optional keys for `mode = "api"` sources:
# NEWSAPI_KEY=
# GNEWS_KEY=
