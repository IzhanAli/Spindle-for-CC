# spindle secrets — copy to ~/.config/spindle/.env and fill in.
#
# Loaded automatically (stdlib, no dependency) from the first of:
#   $SPINDLE_ENV · $SPINDLE_HOME/.env · ~/.config/spindle/.env
# Anything already exported in your shell takes precedence over this file.
#
# Headline rewriting uses your Claude Code login — no key needed for that.
# These are only for the optional `mode = "api"` sources:
# NEWSAPI_KEY=
# GNEWS_KEY=
