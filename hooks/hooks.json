{
  "description": "Rotate the spinner's news pool each session; refresh the cache in the background when stale.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run\" session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
